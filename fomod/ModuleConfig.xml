<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/gemm/ModConfig5.0.xsd">
    <moduleName>Son of a! - Clumsy Weapon Slipping</moduleName>
    <requiredInstallFiles>
        <folder source="00 Core" destination="" priority="0"/>
    </requiredInstallFiles>
    <installSteps order="Explicit">
        <installStep name="Son of a! - Clumsy Weapon Slipping">
            <optionalFileGroups order="Explicit">
                <group name="Extras" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="Papyrus Source Scripts (for modders)">
                            <description>OPTIONAL - not needed to play.

Installs the uncompiled Papyrus source (.psc) to Data\Source\Scripts. Only useful if you want to read, learn from, or edit the scripts. Leave unchecked for a clean install; the mod runs entirely from the compiled scripts in Core.</description>
                            <files>
                                <folder source="01 Source" destination="" priority="0"/>
                            </files>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
</config>
